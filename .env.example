# ==============================================================================
# FloodGuard Environment Configuration Template
# Copy this file to .env and fill in your API credentials.
# If keys are left blank, FloodGuard automatically uses high-fidelity simulation.
# ==============================================================================

# Application & Server Settings
APP_NAME=FloodGuard
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Weather Telemetry (Phase 1)
# Sign up at https://openweathermap.org/api to get a free API key for live rainfall
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
IMD_AWS_API_ENDPOINT=https://mausam.imd.gov.in/api/v1/aws

# River Hydrometry & Gauges (CWC / India-WRIS)
# National Water Informatics Centre / India-WRIS portal token
CWC_WRIS_BASE_URL=https://api.indiawris.gov.in/v2/telemetry
CWC_WRIS_API_KEY=your_cwc_india_wris_key_here

# Geospatial & Basemap Engines (Phase 3 & 4)
# ISRO Bhuvan portal token for CartoDEM 10m/30m elevation models
ISRO_BHUVAN_TOKEN=your_isro_bhuvan_token_here

# MapmyIndia (Mappls) Enterprise API key for street network routing
MAPPLS_API_KEY=your_mappls_api_key_here

# Spatial Database (PostGIS)
# Set your PostgreSQL + PostGIS connection string if persisting logs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/floodguard_db

# Emergency Dissemination (NDMA Sachet / C-DOT CBEAS)
NDMA_SACHET_ENDPOINT=https://sachet.ndma.gov.in/api/v1/cap/broadcast
NDMA_SACHET_AUTH_TOKEN=your_ndma_sachet_token_here
